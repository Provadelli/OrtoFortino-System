{
  "name": "orto-fortino",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "secrets:check": "secretlint \"**/*\"",
    "lighthouse": "npx --yes @lhci/cli@0.16.0 autorun",
    "user:create": "tsx --env-file=.env.local scripts/create-user.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.1.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "secretlint": "^13.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*": "secretlint",
    "*.{ts,tsx}": "oxlint"
  }
}
