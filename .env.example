# Copie para .env.local e preencha. NUNCA versione o .env.local.
# Chaves em: Supabase Dashboard → Project Settings → API Keys

# --- Públicas (vão para o navegador; protegidas pelo RLS) ---
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Somente servidor (BFF em /api). Sem prefixo VITE_! ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Origem permitida para chamadas ao BFF (proteção CSRF). Em produção: https://seu-dominio
APP_ORIGIN=http://localhost:5173

# WhatsApp do suporte (só dígitos: 55 + DDD + número). Aparece nos links "Acionar suporte".
VITE_WHATSAPP_SUPORTE=5500000000000
